# Copy to .env and add your free OpenRouteService token.
# Sign up at https://openrouteservice.org/dev/#/signup (email only, no card).
#
# ORS free tier includes:
#   - 2,000 direction requests / day
#   - 500 matrix requests / day
#   - Geocoding / reverse geocoding
#
# The map picker uses OpenStreetMap tiles (no key needed).
# Reverse geocoding falls back to Nominatim if ORS_API_KEY is empty.
ORS_API_KEY=
