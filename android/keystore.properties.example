# Copy to android/keystore.properties and fill in values before Play Store release.
# Do NOT commit keystore.properties or *.jks / *.keystore files.
#
# Generate a release keystore (one-time):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Required properties:
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=../upload-keystore.jks
#
# Optional environment-variable overrides (CI/CD):
#   KEYSTORE_STORE_PASSWORD, KEYSTORE_KEY_PASSWORD, KEYSTORE_KEY_ALIAS, KEYSTORE_FILE
