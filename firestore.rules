rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function viewerCircleIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/preferences)
        .data.get('circleIds', []);
    }

    function ownerCircleIds(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/settings/preferences)
        .data.get('circleIds', []);
    }

    function sharesCircleWith(userId) {
      return isSignedIn()
        && request.auth.uid != userId
        && viewerCircleIds().hasAny(ownerCircleIds(userId));
    }

    function canReadUserProfile(userId) {
      return isOwner(userId) || sharesCircleWith(userId);
    }

    function canReadPrayerLogs(userId) {
      return isOwner(userId) || sharesCircleWith(userId);
    }

    function isCircleMember(circleId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }

    match /circle_lookup/{inviteCode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.circleId is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /circles/{circleId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.members;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.inviteCode is string
        && request.resource.data.name is string;

      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members
        || request.auth.uid == resource.data.createdBy
        || (
          request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.size()
              == resource.data.members.size() + 1
        )
      );

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.createdBy;

      match /dua_requests/{requestId} {
        allow read: if isCircleMember(circleId);

        allow create: if isCircleMember(circleId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.authorName is string;

        allow update: if isCircleMember(circleId);
      }

      match /streak {
        allow read: if isCircleMember(circleId);
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read: if canReadUserProfile(userId);
      allow write: if isOwner(userId);

      match /settings/{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /status {
        allow read: if isOwner(userId) || sharesCircleWith(userId);
        allow write: if isOwner(userId);
      }

      match /fcmToken {
        allow read, write: if isOwner(userId);
      }

      match /prayer_logs/{date} {
        allow read: if canReadPrayerLogs(userId);
        allow write: if isOwner(userId);

        match /prayers/{prayerName} {
          allow read: if canReadPrayerLogs(userId);
          allow write: if isOwner(userId);
        }
      }

      match /routine_blocks/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /saved_locations/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /streak {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /badges/{badgeId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /islamic_data/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
